{
  "info": {
    "name": "BioCaquetá - Avistamientos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "id", "value": "" }
  ],
  "item": [
    {
      "name": "Crear avistamiento (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreComun\": \"Danta amazónica\",\n  \"nombreCientifico\": \"Tapirus terrestris\",\n  \"categoria\": \"Mamífero\",\n  \"zona\": \"El Caraño\",\n  \"estadoConservacion\": \"Vulnerable\",\n  \"investigador\": \"Estudiante UDLA\"\n}"
        },
        "url": "{{baseUrl}}/api/avistamientos"
      }
    },
    {
      "name": "Listar avistamientos (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/avistamientos" }
    },
    {
      "name": "Filtrar por categoría (GET)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos?categoria=Ave",
          "host": ["{{baseUrl}}"],
          "path": ["api", "avistamientos"],
          "query": [{ "key": "categoria", "value": "Ave" }]
        }
      }
    },
    {
      "name": "Actualizar avistamiento (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zona\": \"Río Hacha\",\n  \"estadoConservacion\": \"En peligro\"\n}"
        },
        "url": "{{baseUrl}}/api/avistamientos/{{id}}"
      }
    },
    {
      "name": "Eliminar avistamiento (DELETE)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/avistamientos/{{id}}" }
    }
  ]
}
