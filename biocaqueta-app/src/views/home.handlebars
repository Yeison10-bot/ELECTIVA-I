<div class="card mb-4">
    <div class="card-header fw-bold">Registrar avistamiento</div>
    <div class="card-body">
        <form action="/api/avistamientos" method="POST" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nombre común</label>
                <input type="text" name="nombreComun" class="form-control" placeholder="Danta amazónica" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Nombre científico</label>
                <input type="text" name="nombreCientifico" class="form-control" placeholder="Tapirus terrestris" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Categoría</label>
                <select name="categoria" class="form-select" required>
                    {{#each categorias}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Zona</label>
                <input type="text" name="zona" class="form-control" placeholder="Río Hacha" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado de conservación</label>
                <select name="estadoConservacion" class="form-select">
                    {{#each estados}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Investigador</label>
                <input type="text" name="investigador" class="form-control" required>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success">Guardar</button>
            </div>
        </form>
    </div>
</div>

<h4>Avistamientos registrados</h4>
{{#if avistamientos.length}}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle bg-white">
        <thead class="table-success">
            <tr>
                <th>Nombre común</th>
                <th>Nombre científico</th>
                <th>Categoría</th>
                <th>Zona</th>
                <th>Estado</th>
                <th>Investigador</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#each avistamientos}}
            <tr>
                <td>{{nombreComun}}</td>
                <td><em>{{nombreCientifico}}</em></td>
                <td>{{categoria}}</td>
                <td>{{zona}}</td>
                <td>{{estadoConservacion}}</td>
                <td>{{investigador}}</td>
                <td>{{fecha fechaRegistro}}</td>
                <td class="text-nowrap">
                    <a href="/editar/{{_id}}" class="btn btn-sm btn-warning">Editar</a>
                    <form action="/api/avistamientos/delete/{{_id}}" method="POST" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este avistamiento?')">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<p class="text-muted">Aún no hay avistamientos registrados.</p>
{{/if}}
