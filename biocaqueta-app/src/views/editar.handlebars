<main class="editar">
    <div class="editar-media" style="view-transition-name: foto-{{avistamiento._id}}">
        {{#if avistamiento.foto}}
        <img src="{{avistamiento.foto.url}}" alt="{{avistamiento.nombreComun}}">
        {{else}}
        <span class="sin-foto">{{inicial avistamiento.nombreComun}}</span>
        {{/if}}
        <div class="editar-titulo">
            <h1>{{avistamiento.nombreComun}}</h1>
            <p class="cientifico">{{avistamiento.nombreCientifico}}</p>
            <p class="editar-meta">{{avistamiento.categoria}} · {{avistamiento.investigador}} · {{fecha avistamiento.fechaRegistro}}</p>
        </div>
        {{#if avistamiento.foto}}
        <p class="credito">Foto: {{avistamiento.foto.credito}} · iNaturalist</p>
        {{/if}}
    </div>

    <form action="/api/avistamientos/update/{{avistamiento._id}}" method="POST" class="editar-form">
        <a href="/" class="volver">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            Volver a los avistamientos
        </a>

        <h2>Actualizar registro</h2>
        <p class="ayuda">Puedes cambiar la zona y el estado de conservación.</p>

        <label>Zona
            <input type="text" name="zona" value="{{avistamiento.zona}}" required>
        </label>

        <fieldset>
            <legend>Estado de conservación</legend>
            <div class="opciones opciones-columna">
                {{#each estados}}
                <label class="opcion opcion-{{estadoClase this}}">
                    <input type="radio" name="estadoConservacion" value="{{this}}" {{#if (eq this ../avistamiento.estadoConservacion)}}checked{{/if}}>
                    <span>{{this}}</span>
                </label>
                {{/each}}
            </div>
        </fieldset>

        <div class="acciones">
            <button type="submit" class="boton boton-primario">Guardar cambios</button>
            <a href="/" class="boton boton-fantasma">Cancelar</a>
        </div>
    </form>
</main>
