<div class="card">
    <div class="card-header fw-bold">Editar avistamiento</div>
    <div class="card-body">
        <form action="/api/avistamientos/update/{{avistamiento._id}}" method="POST" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre común</label>
                <input type="text" class="form-control" value="{{avistamiento.nombreComun}}" disabled>
            </div>
            <div class="col-md-6">
                <label class="form-label">Nombre científico</label>
                <input type="text" class="form-control" value="{{avistamiento.nombreCientifico}}" disabled>
            </div>
            <div class="col-md-6">
                <label class="form-label">Zona</label>
                <input type="text" name="zona" class="form-control" value="{{avistamiento.zona}}" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Estado de conservación</label>
                <select name="estadoConservacion" class="form-select">
                    {{#each estados}}
                    <option value="{{this}}" {{#if (eq this ../avistamiento.estadoConservacion)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success">Actualizar</button>
                <a href="/" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
